<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:SerialPortTerminal.Application"
        x:Class="SerialPortTerminal.MainWindow"
        x:DataType="app:TerminalConfiguration"
        Title="Serial Port Terminal"
        Width="1180" Height="780"
        MinWidth="900" MinHeight="600">
  <Grid RowDefinitions="*,Auto" Margin="16" RowSpacing="12">
    <Grid ColumnDefinitions="270,*" ColumnSpacing="14">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <Border Padding="12" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Connection" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="Disconnected" VerticalAlignment="Center" Opacity="0.75" />
              </Grid>
              <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="Port" VerticalAlignment="Center" />
                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <ComboBox x:Name="PortBox" SelectedItem="{Binding PortName, Mode=TwoWay}" />
                  <Button x:Name="RefreshPortsButton" Grid.Column="1" Content="↻" Width="34" Click="RefreshPorts_Click" />
                </Grid>
                <TextBlock Grid.Row="1" Text="Baud" VerticalAlignment="Center" />
                <ComboBox x:Name="BaudBox" Grid.Row="1" Grid.Column="1" SelectedItem="{Binding BaudRate, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Text="Data bits" VerticalAlignment="Center" />
                <ComboBox x:Name="DataBitsBox" Grid.Row="2" Grid.Column="1" SelectedItem="{Binding DataBits, Mode=TwoWay}" />
                <TextBlock Grid.Row="3" Text="Parity" VerticalAlignment="Center" />
                <ComboBox x:Name="ParityBox" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Parity, Mode=TwoWay}" />
                <TextBlock Grid.Row="4" Text="Stop bits" VerticalAlignment="Center" />
                <ComboBox x:Name="StopBitsBox" Grid.Row="4" Grid.Column="1" SelectedItem="{Binding StopBits, Mode=TwoWay}" />
                <TextBlock Grid.Row="5" Text="Handshake" VerticalAlignment="Center" />
                <ComboBox x:Name="HandshakeBox" Grid.Row="5" Grid.Column="1" SelectedItem="{Binding Handshake, Mode=TwoWay}" />
                <TextBlock Grid.Row="6" Text="RTS" VerticalAlignment="Center" />
                <ComboBox x:Name="RtsBox" Grid.Row="6" Grid.Column="1" SelectedItem="{Binding RtsMode, Mode=TwoWay}" />
              </Grid>
              <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>

          <Border Padding="12" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="8">
              <TextBlock Text="Received display" FontSize="16" FontWeight="SemiBold" />
              <ComboBox x:Name="ReceivedFormatBox" SelectedItem="{Binding ReceivedDataFormat, Mode=TwoWay}" />
              <CheckBox Content="Show CRC bytes" IsChecked="{Binding ShowCrcBytes, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Padding="12" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="8">
              <TextBlock Text="Diagnostic logging" FontSize="16" FontWeight="SemiBold" />
              <CheckBox Content="Include detailed transport events" IsChecked="{Binding IncludeDetailedTransportEvents, Mode=TwoWay}" />
              <TextBlock Text="The automatic session log continues even when detailed events are disabled." TextWrapping="Wrap" Opacity="0.65" />
            </StackPanel>
          </Border>

          <Border Padding="12" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="8">
              <TextBlock Text="Protocol" FontSize="16" FontWeight="SemiBold" />
              <CheckBox x:Name="CrcBox" Content="Use CRC" IsChecked="{Binding UseCrc, Mode=TwoWay}" />
              <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <TextBlock Text="Polynomial" VerticalAlignment="Center" />
                <TextBox x:Name="CrcPolynomialBox" Grid.Column="1" Text="{Binding CrcPolynomial, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Text="Initial" VerticalAlignment="Center" />
                <TextBox x:Name="CrcInitialBox" Grid.Row="1" Grid.Column="1" Text="{Binding CrcInitialValue, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Text="Residue" VerticalAlignment="Center" />
                <TextBox x:Name="CrcResidueBox" Grid.Row="2" Grid.Column="1" Text="{Binding CrcExpectedResidue, Mode=TwoWay}" />
                <TextBlock Grid.Row="3" Text="Term char" VerticalAlignment="Center" />
                <TextBox x:Name="TermCharBox" Grid.Row="3" Grid.Column="1" Text="{Binding TermChar, Mode=TwoWay}" />
              </Grid>
              <CheckBox x:Name="CrcPostInvertBox" Content="Post-invert CRC" IsChecked="{Binding CrcPostInvert, Mode=TwoWay}" />
              <CheckBox x:Name="CrcMsBitFirstBox" Content="MS bit first" IsChecked="{Binding CrcMsBitFirst, Mode=TwoWay}" />
              <CheckBox x:Name="CrcMsByteFirstBox" Content="MS byte first" IsChecked="{Binding CrcMsByteFirst, Mode=TwoWay}" />
              <CheckBox x:Name="OmitTermCharBox" Content="No term character (silence framed)" IsChecked="{Binding OmitTermChar, Mode=TwoWay}" />
              <CheckBox x:Name="IgnoreCrcErrorsBox" Content="Deliver messages with CRC errors" IsChecked="{Binding DeliverCrcErrors, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Padding="12" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="6">
              <TextBlock Text="Signals" FontSize="16" FontWeight="SemiBold" />
              <UniformGrid Columns="3" Rows="2">
                <TextBlock x:Name="RtsSignal" Text="RTS —" />
                <TextBlock x:Name="CtsSignal" Text="CTS —" />
                <TextBlock x:Name="DtrSignal" Text="DTR —" />
                <TextBlock x:Name="DsrSignal" Text="DSR —" />
                <TextBlock x:Name="DcdSignal" Text="DCD —" />
                <TextBlock x:Name="RiSignal" Text="RI —" />
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <TabControl Grid.Column="1">
        <TabItem Header="Communications">
          <Grid Margin="10" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Padding="10" BorderThickness="1" CornerRadius="4">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Text="Send" FontWeight="SemiBold" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="CommandBox" Watermark="Enter command" KeyDown="CommandBox_KeyDown" />
                  <Button x:Name="SendButton" Grid.Column="1" Content="Send" Click="Send_Click" MinWidth="92" />
                </Grid>
              </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Received" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear" Click="ClearReceived_Click" />
              </Grid>
              <TextBox x:Name="ReceivedBox" Grid.Row="1"
                       IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       FontFamily="Consolas, Cascadia Mono, monospace"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Transport Diagnostics">
          <Grid Margin="10" RowDefinitions="Auto,Auto,*" RowSpacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <StackPanel>
                <TextBlock Text="Transport Diagnostics" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Detailed record of how serial traffic was transported and processed" Opacity="0.65" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="Word wrap" VerticalAlignment="Center"
                        IsChecked="{Binding DiagnosticWordWrap, Mode=TwoWay}" />
              <Button Grid.Column="2" Content="Clear" Click="ClearDiagnostics_Click" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="Log" VerticalAlignment="Center" />
              <TextBox x:Name="LogFileBox" Grid.Column="1" IsReadOnly="True" />
            </Grid>
            <TextBox x:Name="DiagnosticsBox" Grid.Row="2"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas, Cascadia Mono, monospace"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <TextBlock Grid.Row="1" Text="Enter sends. Up/Down recalls sent commands. Connection settings are locked while connected." Opacity="0.6" />
  </Grid>
</Window>
